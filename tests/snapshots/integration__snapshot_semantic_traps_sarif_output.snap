          "ruleId": "MISSING_CERTIFICATE"
        },
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures/semantic_traps.config"
                },
                "region": {
                  "startLine": 9
                }
              }
            }
          ],
          "message": {
            "text": "LocalCommand is ignored because PermitLocalCommand is not enabled Hint: add PermitLocalCommand yes in an applicable scope or remove LocalCommand"
