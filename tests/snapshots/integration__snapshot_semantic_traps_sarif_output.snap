        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures/semantic_traps.config"
                },
                "region": {
                  "startLine": 9
                }
              }
            }
          ],
          "message": {
            "text": "unsupported percent token '%Z' in LocalCommand Hint: escape a literal percent sign as %% or use a token supported by this directive"
          },
          "ruleId": "INVALID_TOKEN"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://sshconfig-lint.apps.thiering.org",
          "name": "sshconfig-lint",
          "rules": [
            {
              "helpUri": "https://sshconfig-lint.apps.thiering.org/en/rules/invalid-percent-token",
              "id": "INVALID_TOKEN",
              "name": "invalid-percent-token",
