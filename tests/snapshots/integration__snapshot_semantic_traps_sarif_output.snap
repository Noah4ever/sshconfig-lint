            "text": "RevokedHostKeys file is missing or unreadable: tests/fixtures/missing-revoked.krl; host authentication will be refused for all hosts Hint: fix the path, permissions, or use RevokedHostKeys none intentionally"
          },
          "ruleId": "REVOKED_HOST_KEYS_UNREADABLE"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures/semantic_traps.config"
                },
